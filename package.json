{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "monitor": "node scripts/monitor-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "rm -f .data-test/test.db* && SPLICECHECK_DB=.data-test/test.db tsx --test tests/*.test.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --banner:js='#!/usr/bin/env node' --log-level=warning && chmod +x dist/cli.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "splicecheck": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
